# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit your actual credentials.

OPENALEX_EMAIL=your_email_here@example.com

# ── Google Drive Integration ──────────────────────────────────────────────────
# Path to the Service Account JSON key file (download from Google Cloud Console)
# GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service_account.json

# The ID of the Google Drive folder where the Excel file will be stored.
# Find it in the folder URL: drive.google.com/drive/folders/<FOLDER_ID>
# GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here
